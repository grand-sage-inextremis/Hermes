{
	"name": "@inextremis/hermes",
	"version": "0.1.0",
	"description": "A JavaScript router",
	"author": "Grand Sage InExtremis <grand.sage.inextremis@gmail.com>",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.12.1"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.js",
			"default": "./dist/index.cjs"
		}
	},
	"files": [
		"./dist/",
		"./package.json",
		"./README.md",
		"./CHANGELOG.md",
		"./LICENSE"
	],
	"scripts": {
		"test": "(ENV=test tsup && vitest) ; rm -r ./build-test/",
		"build": "cross-env ENV=production tsup",
		"build:dev": "cross-env ENV=development tsup"
	},
	"homepage": "https://github.com/grand-sage-inextremis/Hermes#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/grand-sage-inextremis/Hermes.git"
	},
	"bugs": {
		"url": "https://github.com/grand-sage-inextremis/Hermes/issues"
	},
	"devDependencies": {
		"@types/node": "^24.2.0",
		"cross-env": "^10.1.0",
		"dotenv": "^16.5.0",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"vitest": "^3.1.1"
	}
}
